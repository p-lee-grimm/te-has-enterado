# Скопируй в .env и заполни. .env в git не попадает.

# Postgres с расширением pgvector (Supabase). Обязателен.
DATABASE_URL=postgresql://user:pass@host:5432/postgres

# Попадает в User-Agent — требование §5.6 (честное представление бота).
CONTACT_EMAIL=you@example.com

# Пересказ (стадия summarize)
ANTHROPIC_API_KEY=

# Эмбеддинги (стадия embed). Ключ под выбранный embed.provider.
VOYAGE_API_KEY=
# OPENAI_API_KEY=
# COHERE_API_KEY=

# Публикация (стадия publish)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
# Приватный чат для служебных сообщений: ревью, аварии, карточки, сводки.
# Единственное место, куда бот пишет владельцу (§9) — три места игнорируются.
REVIEW_CHAT_ID=
# Числовой id канала (-100…): не меняется при переименовании, в отличие от @имени
TELEGRAM_CHANNEL_ID=
# @имя без собачки — только для ссылок t.me/<имя>/<id> внутри постов
TELEGRAM_CHANNEL_USERNAME=

# Необязательно: перебивает publish.review_mode из settings.yaml
# REVIEW_MODE=true

# Автопубликация. Важнее значения в config/settings.yaml — специально:
# конфиг лежит в git, и обновление сервера затёрло бы правку молча.
# AUTOPOST_ENABLED=true
