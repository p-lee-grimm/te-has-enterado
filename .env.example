# Скопируй в .env и заполни. .env в git не попадает.

# Postgres с расширением pgvector (Supabase). Обязателен.
DATABASE_URL=postgresql://user:pass@host:5432/postgres

# Попадает в User-Agent — требование §5.6 (честное представление бота).
CONTACT_EMAIL=you@example.com

# Пересказ (стадия summarize)
ANTHROPIC_API_KEY=

# Эмбеддинги (стадия embed). Ключ под выбранный embed.provider.
VOYAGE_API_KEY=
# OPENAI_API_KEY=
# COHERE_API_KEY=

# Публикация (стадия publish)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_CHANNEL_ID=

# Необязательно: перебивает publish.review_mode из settings.yaml
# REVIEW_MODE=true
